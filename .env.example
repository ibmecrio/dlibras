EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Vision Agent service (Python) — used by the agent-session API route
# Default: http://localhost:8000 (run `uv run main.py serve` inside vision-agent/)
VISION_AGENT_URL=http://localhost:8000

# OpenAI API key — required only for the vision-agent Python service
# Add this to vision-agent/.env (not here); listed here for discoverability
# OPENAI_API_KEY=your_openai_api_key

# DLibras — Libras hand-sign recognition API (Python + FastAPI)
# Run `python api_server.py` inside the Libras recognition folder.
# When running on a real device, replace `localhost` with your machine's LAN IP
# (e.g. http://192.168.0.10:8001) so the phone can reach the server.
EXPO_PUBLIC_LIBRAS_API_URL=http://localhost:8001
