# ─────────────────────────────────────────────────────────────────────
# DLibras — production env template
# Copy to docker/.env.production and fill the real values BEFORE
# running `docker compose --env-file docker/.env.production up -d`.
# Never commit docker/.env.production to git.
# ─────────────────────────────────────────────────────────────────────

# ── Web build-time (EXPO_PUBLIC_*) ───────────────────────────────────
# These end up baked into the static JS bundle. Leave empty unless you
# really want the value visible to every browser. "Server-side proxy
# mode" is the default: web talks to /api/* through nginx and the API
# container holds the real secrets.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_LIBRAS_API_URL=/api
EXPO_PUBLIC_PROXY_SECRET=
EXPO_PUBLIC_POSTHOG_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=

# ── Server-only AI keys (used by api_server.py proxy routes) ─────────
# /api/anthropic/messages   ← ANTHROPIC_API_KEY
# /api/elevenlabs/tts       ← ELEVENLABS_API_KEY
# /api/assemblyai/*         ← ASSEMBLYAI_API_KEY
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=

# Optional: voice agent (Stream) + Clerk backend, only if you re-enable
# them. Leave blank for demo mode.
CLERK_SECRET_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=
OPENAI_API_KEY=

# ── Proxy authentication ─────────────────────────────────────────────
# The web bundle sends DLIBRAS_PROXY_SECRET via header; the API rejects
# requests that don't match. MUST equal EXPO_PUBLIC_PROXY_SECRET above.
DLIBRAS_PROXY_SECRET=change-me-in-production

# CORS allow-list for the FastAPI service.
DLIBRAS_ALLOWED_ORIGINS=https://dlibras.app,https://www.dlibras.app

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=dlibras
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=dlibras

# Full URL handed to the API container. Hostname `db` is the service
# name in docker-compose.yml and only resolves on the `backend` network.
DATABASE_URL=postgres://dlibras:change-me-in-production@db:5432/dlibras

# ── Let's Encrypt ────────────────────────────────────────────────────
# Used by the first-issue command in DEPLOY-DOCKER.md.
LETSENCRYPT_EMAIL=admin@dlibras.app
LETSENCRYPT_DOMAINS=dlibras.app,www.dlibras.app
