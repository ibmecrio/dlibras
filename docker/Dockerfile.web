# syntax=docker/dockerfile:1.6
# ─────────────────────────────────────────────────────────────────────
# DLibras — Web frontend (Expo Router static export served by Nginx)
# ─────────────────────────────────────────────────────────────────────
# Stage 1: build static bundle with Expo
# ─────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Pin pnpm via corepack so we don't depend on a global install on the host.
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

# Build deps that some native node modules need at install time.
RUN apk add --no-cache git python3 make g++ bash

WORKDIR /app

# Copy manifests first to maximize Docker layer cache hits.
COPY package.json pnpm-lock.yaml* package-lock.json* ./
COPY .npmrc* ./

# `--shamefully-hoist` flattens the node_modules tree, matching the layout
# Expo/Metro expect (same workaround we use locally for the lightningcss override).
RUN pnpm install --shamefully-hoist --frozen-lockfile=false

# Copy the rest of the project. The .dockerignore at the project root keeps
# node_modules, .git, .venv and the Libras dataset out of the build context.
COPY . .

# Build-time public env vars — re-declare here so callers can pass them via
# `docker compose build --build-arg EXPO_PUBLIC_...=...`. Defaults are empty
# strings so the bundle ships in "proxy-only" mode (the API server holds the
# real secrets and the web client talks to /api/* through nginx).
ARG EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""
ARG EXPO_PUBLIC_LIBRAS_API_URL="/api"
ARG EXPO_PUBLIC_PROXY_SECRET=""
ARG EXPO_PUBLIC_POSTHOG_TOKEN=""
ARG EXPO_PUBLIC_POSTHOG_HOST=""

ENV EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY \
    EXPO_PUBLIC_LIBRAS_API_URL=$EXPO_PUBLIC_LIBRAS_API_URL \
    EXPO_PUBLIC_PROXY_SECRET=$EXPO_PUBLIC_PROXY_SECRET \
    EXPO_PUBLIC_POSTHOG_TOKEN=$EXPO_PUBLIC_POSTHOG_TOKEN \
    EXPO_PUBLIC_POSTHOG_HOST=$EXPO_PUBLIC_POSTHOG_HOST \
    NODE_ENV=production \
    CI=1

# Static export — outputs to /app/dist by default.
RUN pnpm exec expo export -p web

# ─────────────────────────────────────────────────────────────────────
# Stage 2: serve the static bundle with nginx
# ─────────────────────────────────────────────────────────────────────
FROM nginx:alpine AS web

# Replace the default site config with our SPA-friendly one.
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf

# Copy the static export.
COPY --from=builder /app/dist /usr/share/nginx/html

# Health check so `docker compose ps` reflects readiness.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
