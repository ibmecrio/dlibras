# syntax=docker/dockerfile:1.6
# ─────────────────────────────────────────────────────────────────────
# DLibras — Vision API (FastAPI + MediaPipe + KNN over uvicorn)
# Source: Digital-Inclusion-and-Accessibility-A-Computer-Vision-Model-for-Automated-Libras-Recognition/
# ─────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS api

# Non-interactive apt + python tweaks for slimmer images and faster startup.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# System deps:
#  - libgl1 / libglib2.0-0 → OpenCV runtime
#  - libsm6 / libxext6 / libxrender1 → MediaPipe / cv2 image ops
#  - libgomp1 → numpy / scikit-learn OpenMP runtime
#  - curl → healthcheck without needing python
#  - ca-certificates → outbound HTTPS (Anthropic / ElevenLabs / AssemblyAI proxies)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgomp1 \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install python deps first for cacheability.
COPY Digital-Inclusion-and-Accessibility-A-Computer-Vision-Model-for-Automated-Libras-Recognition/requirements.txt ./requirements.txt
RUN pip install --upgrade pip \
    && pip install -r requirements.txt \
    && pip install "fastapi==0.115.0" "uvicorn[standard]==0.32.0" "python-multipart==0.0.12"

# Copy the rest of the backend source (api_server, extract.py, models/, etc.).
COPY Digital-Inclusion-and-Accessibility-A-Computer-Vision-Model-for-Automated-Libras-Recognition/ ./

# Drop privileges — the image runs as a non-root user.
RUN useradd --create-home --uid 10001 dlibras \
    && chown -R dlibras:dlibras /app
USER dlibras

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8001/health || exit 1

# 2 workers is a sweet spot for a single-GPU/CPU box that also runs nginx + db.
# Bump via docker-compose `command:` if you have more cores.
CMD ["uvicorn", "api_server:app", \
     "--host", "0.0.0.0", \
     "--port", "8001", \
     "--workers", "2", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*", \
     "--log-level", "info"]
