FROM node:20-alpine AS builder

RUN apk add --no-cache git python3 make g++ && \
    corepack enable && corepack prepare pnpm@10 --activate

WORKDIR /app

# Clona o repo público — o web export é build-time, sem depender da VPS ter o código.
ARG GIT_REF=main
RUN git clone --depth 1 --branch ${GIT_REF} https://github.com/ibmecrio/dlibras.git . && \
    pnpm install --shamefully-hoist --frozen-lockfile

# Build args pra injetar nas vars EXPO_PUBLIC_ no bundle
ARG EXPO_PUBLIC_LIBRAS_API_URL=https://api.dlibras.app
ARG EXPO_PUBLIC_USE_PROXY=true
ARG EXPO_PUBLIC_PROXY_SECRET=""
ARG EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

ENV EXPO_PUBLIC_LIBRAS_API_URL=${EXPO_PUBLIC_LIBRAS_API_URL} \
    EXPO_PUBLIC_USE_PROXY=${EXPO_PUBLIC_USE_PROXY} \
    EXPO_PUBLIC_PROXY_SECRET=${EXPO_PUBLIC_PROXY_SECRET} \
    EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=${EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY}

RUN pnpm exec expo export -p web

# ─── Runtime stage ──────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
RUN echo $'server { \n\
  listen 80; \n\
  server_name _; \n\
  root /usr/share/nginx/html; \n\
  index index.html; \n\
  \n\
  # Cache imutável pra assets versionados \n\
  location /_expo/static/ { \n\
    add_header Cache-Control "public, max-age=31536000, immutable"; \n\
    try_files $uri =404; \n\
  } \n\
  \n\
  # Manifest sem cache forte \n\
  location = /manifest.webmanifest { \n\
    add_header Content-Type application/manifest+json; \n\
    add_header Cache-Control "public, max-age=0, must-revalidate"; \n\
  } \n\
  \n\
  location = /sw.js { \n\
    add_header Cache-Control "public, max-age=0, must-revalidate"; \n\
    add_header Service-Worker-Allowed "/"; \n\
  } \n\
  \n\
  # SPA fallback \n\
  location / { \n\
    try_files $uri $uri/ $uri.html /index.html; \n\
  } \n\
  \n\
  # gzip \n\
  gzip on; \n\
  gzip_vary on; \n\
  gzip_types text/css application/javascript application/json image/svg+xml; \n\
  gzip_min_length 256; \n\
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O- http://localhost/ || exit 1
