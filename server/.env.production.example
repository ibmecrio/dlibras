# DLibras backend — variáveis server-side (NÃO commitar com valores reais).
#
# Copia este arquivo pra `.env` no diretório `/opt/dlibras/` da VPS e preenche.
# Permissão restrita: chmod 600 .env

# ─── Keys de IA (server-side proxy mode) ─────────────────────────────────────
# Quando o frontend tá com EXPO_PUBLIC_USE_PROXY=true, ele NÃO carrega essas
# keys no bundle — em vez disso chama /api/anthropic, /api/elevenlabs,
# /api/assemblyai aqui, e o servidor proxia com essas keys.
ANTHROPIC_API_KEY=sk-ant-api03-...
ELEVENLABS_API_KEY=sk_...
ASSEMBLYAI_API_KEY=...

# ─── Autenticação do proxy ──────────────────────────────────────────────────
# Bearer token que o frontend manda no header Authorization. Gere com:
#   openssl rand -hex 32
DLIBRAS_PROXY_SECRET=...

# ─── CORS ────────────────────────────────────────────────────────────────────
# Lista separada por vírgula dos domínios autorizados. * libera tudo (dev only).
# Em prod use os domínios reais do front (Vercel + custom domain):
DLIBRAS_ALLOWED_ORIGINS=https://dlibras.vercel.app,https://dlibras.app
